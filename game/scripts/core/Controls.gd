const KEY_NAMES := {
	"QuoteLeft": "`", "BracketLeft": "[", "BracketRight": "]", "Equal": "=", "Plus": "+", "Minus": "-",
	"Kp Add": "Keypad +", "Kp Subtract": "Keypad -", "Kp Enter": "Keypad Enter",
}
const MOUSE_NAMES := {
	MOUSE_BUTTON_LEFT: "Left mouse", MOUSE_BUTTON_RIGHT: "Right mouse", MOUSE_BUTTON_MIDDLE: "Middle mouse",
	MOUSE_BUTTON_WHEEL_UP: "Wheel up", MOUSE_BUTTON_WHEEL_DOWN: "Wheel down",
}
const JOY_NAMES := {
	JOY_BUTTON_A: "A", JOY_BUTTON_B: "B", JOY_BUTTON_X: "X", JOY_BUTTON_Y: "Y", JOY_BUTTON_BACK: "Back",
	JOY_BUTTON_START: "Start", JOY_BUTTON_DPAD_UP: "D-pad up", JOY_BUTTON_DPAD_DOWN: "D-pad down",
	JOY_BUTTON_DPAD_LEFT: "D-pad left", JOY_BUTTON_DPAD_RIGHT: "D-pad right",
}

const MODIFIER_MASK := KEY_MASK_SHIFT | KEY_MASK_ALT | KEY_MASK_META | KEY_MASK_CTRL | KEY_MASK_CMD_OR_CTRL

static var built := {}

# the actions this game owns, in table order (builtins left out)
static func actions() -> Array[StringName]:
	var out: Array[StringName] = []
	for action in TABLE:
		if not is_builtin(action):
			out.append(action)
	return out

static func is_builtin(action: StringName) -> bool:
	return TABLE.has(action) and TABLE[action].get("builtin", false)

static func entry(action: StringName) -> Dictionary:
	return TABLE.get(action, {})

# the table's bindings of an action as input events, built once
static func events(action: StringName) -> Array[InputEvent]:
	if built.has(action):
		return built[action]

	var out: Array[InputEvent] = []
	var data := entry(action)
	var physical: bool = data.get("physical", false)

	for code in data.get("keys", []):
		var key := InputEventKey.new()
		key.device = -1
		var bare: int = code & ~MODIFIER_MASK
		if physical:
			key.physical_keycode = bare
		else:
			key.keycode = bare
		apply_modifiers(key, code)
		out.append(key)

	for code in data.get("mouse", []):
		var button := InputEventMouseButton.new()
		button.device = -1
		button.button_index = code & ~MODIFIER_MASK
		apply_modifiers(button, code)
		out.append(button)

	for index in data.get("joy", []):
		var joy := InputEventJoypadButton.new()
		joy.device = -1
		joy.button_index = index
		out.append(joy)

	built[action] = out
	return out

static func apply_modifiers(event: InputEventWithModifiers, code: int) -> void:
	if code & KEY_MASK_CMD_OR_CTRL:
		event.command_or_control_autoremap = true
	else:
		event.ctrl_pressed = bool(code & KEY_MASK_CTRL)
		event.meta_pressed = bool(code & KEY_MASK_META)
	event.shift_pressed = bool(code & KEY_MASK_SHIFT)
	event.alt_pressed = bool(code & KEY_MASK_ALT)

# adds every table action missing from the InputMap, and every binding
# missing from an action. never removes, so a later rebind survives
static func register() -> void:
	for action in actions():
		if not InputMap.has_action(action):
			InputMap.add_action(action, DEADZONE)

		for event in events(action):
			if not has_event(InputMap.action_get_events(action), event):
				InputMap.action_add_event(action, event)

static func has_event(list: Array, event: InputEvent) -> bool:
	for other in list:
		if same_event(other, event):
			return true
	return false

# the same binding: same class, button or key (and whether physical) and
# the same modifiers
static func same_event(a: InputEvent, b: InputEvent) -> bool:
	if a.get_class() != b.get_class():
		return false

	if a is InputEventKey:
		if a.keycode != b.keycode or a.physical_keycode != b.physical_keycode:
			return false
	elif a is InputEventMouseButton or a is InputEventJoypadButton:
		if a.button_index != b.button_index:
			return false
	else:
		return a.is_match(b, true)

	if a is InputEventWithModifiers:
		return modifiers_of(a) == modifiers_of(b)
	return true

static func modifiers_of(event: InputEventWithModifiers) -> int:
	var mask := 0
	if event.ctrl_pressed or event.meta_pressed:
		mask |= KEY_MASK_CTRL
	if event.shift_pressed:
		mask |= KEY_MASK_SHIFT
	if event.alt_pressed:
		mask |= KEY_MASK_ALT
	return mask

# the bindings to test against: the InputMap's when the action is in it
# (the running game), the table's otherwise (inside the Godot editor)
static func bindings(action: StringName) -> Array:
	if InputMap.has_action(action):
		return InputMap.action_get_events(action)
	return events(action)

# the event is one of the action's bindings, pressed or released
static func matches(event: InputEvent, action: StringName) -> bool:
	for binding in bindings(action):
		if binding_matches(binding, event):
			return true
	return false

static func binding_matches(binding: InputEvent, event: InputEvent) -> bool:
	if binding is InputEventKey:
		if not (event is InputEventKey):
			return false
		if binding.physical_keycode != KEY_NONE:
			if binding.physical_keycode != event.physical_keycode:
				return false
		elif binding.keycode != event.keycode:
			return false
	elif binding is InputEventMouseButton:
		if not (event is InputEventMouseButton) or binding.button_index != event.button_index:
			return false
	elif binding is InputEventJoypadButton:
		return event is InputEventJoypadButton and binding.button_index == event.button_index
	else:
		return binding.is_match(event, false)

	# the binding's modifiers must be held, and Ctrl exactly as bound
	var want := modifiers_of(binding)
	var have := modifiers_of(event)
	return (want & have) == want and (want & KEY_MASK_CTRL) == (have & KEY_MASK_CTRL)

static func pressed(event: InputEvent, action: StringName, allow_echo := false) -> bool:
	if not event.is_pressed() or (event.is_echo() and not allow_echo):
		return false
	return matches(event, action)

static func released(event: InputEvent, action: StringName) -> bool:
	return not event.is_pressed() and matches(event, action)

# a binding of the action is down right now, read from the device state so
# it answers inside the Godot editor too
static func held(action: StringName) -> bool:
	for binding in bindings(action):
		if binding is InputEventKey:
			if binding.physical_keycode != KEY_NONE and Input.is_physical_key_pressed(binding.physical_keycode):
				return true
			if binding.keycode != KEY_NONE and Input.is_key_pressed(binding.keycode):
				return true
		elif binding is InputEventMouseButton:
			if Input.is_mouse_button_pressed(binding.button_index):
				return true
		elif binding is InputEventJoypadButton:
			for device in Input.get_connected_joypads():
				if Input.is_joy_button_pressed(device, binding.button_index):
					return true
	return false

# an action bound to a modifier key (Shift, Alt, Ctrl) is held on this
# event, read off the event so a synthesized one answers too, else the
# device state
static func modifier_held(event: InputEventWithModifiers, action: StringName) -> bool:
	for binding in bindings(action):
		if not (binding is InputEventKey):
			continue
		var code: int = binding.keycode if binding.keycode != KEY_NONE else binding.physical_keycode
		if (code == KEY_SHIFT and event.shift_pressed) or (code == KEY_ALT and event.alt_pressed) or (code == KEY_CTRL and (event.ctrl_pressed or event.meta_pressed)):
			return true
	return held(action)

# the mouse button index belongs to the action, for code that carries
# the index along (canvas signals, a stroke in progress)
static func has_mouse_button(action: StringName, index: int) -> bool:
	for binding in bindings(action):
		if binding is InputEventMouseButton and binding.button_index == index:
			return true
	return false

# a Shortcut of the action's key bindings, for buttons and menus inside the
# Godot editor where the game's InputMap is not loaded
static func shortcut(action: StringName) -> Shortcut:
	var out := Shortcut.new()
	var list: Array = []
	for event in events(action):
		if event is InputEventKey:
			list.append(event)
	out.events = list
	return out

# the list

static func key_text(code: int) -> String:
	var parts := OS.get_keycode_string(code).split("+")
	var last := parts[parts.size() - 1]
	if KEY_NAMES.has(last):
		parts[parts.size() - 1] = KEY_NAMES[last]
	return "+".join(parts)

static func key_texts(action: StringName) -> PackedStringArray:
	var data := entry(action)
	var out := PackedStringArray()
	for code in data.get("keys", []):
		out.append(key_text(code))
	return out

static func mouse_texts(action: StringName) -> PackedStringArray:
	var out := PackedStringArray()
	for code in entry(action).get("mouse", []):
		var text: String = MOUSE_NAMES.get(code & ~MODIFIER_MASK, "Mouse %d" % (code & ~MODIFIER_MASK))
		var mods: int = code & MODIFIER_MASK
		if mods:
			text = OS.get_keycode_string(mods).trim_suffix("+") + "+" + text
		out.append(text)
	return out

static func joy_texts(action: StringName) -> PackedStringArray:
	var out := PackedStringArray()
	for index in entry(action).get("joy", []):
		out.append("Pad " + JOY_NAMES.get(index, "button %d" % index))
	return out

# every action with its bindings as text, grouped in GROUPS order then
# table order: {action, group, description, keys, mouse, joy, physical, builtin}
static func describe() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for group in GROUPS:
		for action in TABLE:
			var data: Dictionary = TABLE[action]
			if data["group"] != group:
				continue
			out.append({
				"action": action,
				"group": group,
				"description": data["description"],
				"keys": key_texts(action),
				"mouse": mouse_texts(action),
				"joy": joy_texts(action),
				"physical": data.get("physical", false),
				"builtin": data.get("builtin", false),
			})
	return out

# all of an action's bindings on one line, "A, Left, Pad Start"
static func bindings_text(row: Dictionary) -> String:
	var all := PackedStringArray()
	all.append_array(row["keys"])
	all.append_array(row["mouse"])
	all.append_array(row["joy"])
	return ", ".join(all)

# docs/CONTROLS.md
static func markdown() -> String:
	var lines := PackedStringArray()
	lines.append("# Controls")
	lines.append("")
	lines.append("Generated from `game/scripts/core/Controls.gd` by `game/scripts/core/GenerateControlsDoc.gd`, do not edit by hand.")
	lines.append("Keys marked with * are bound by position (the same place on any keyboard layout). Actions marked builtin are Godot's own ui_* actions.")
	lines.append("")
	var group := ""
	for row in describe():
		if row["group"] != group:
			if group != "":
				lines.append("")
			group = row["group"]
			lines.append("## " + group)
			lines.append("")
			lines.append("| Action | Keys | Mouse | Pad | Description |")
			lines.append("| --- | --- | --- | --- | --- |")
		var keys: PackedStringArray = row["keys"]
		var marked := PackedStringArray()
		for key in keys:
			marked.append(key + ("*" if row["physical"] else ""))
		var key_cell := ", ".join(marked)
		var name_cell := "`%s`%s" % [row["action"], " (builtin)" if row["builtin"] else ""]
		lines.append("| %s | %s | %s | %s | %s |" % [name_cell, cell(key_cell), cell(", ".join(row["mouse"])), cell(", ".join(row["joy"])), row["description"].replace("|", "\\|")])
	lines.append("")
	return "\n".join(lines)

static func cell(text: String) -> String:
	if text.is_empty():
		return ""
	return text.replace("|", "\\|").replace("`", "\\`")

# project.godot's [input] section, one entry per owned action
static func project_input_text() -> String:
	var lines := PackedStringArray()
	lines.append("[input]")
	lines.append("")
	for action in actions():
		# a plain Array, a typed one serializes as Array[InputEvent](...)
		var list: Array = []
		list.append_array(events(action))
		lines.append("%s=%s" % [action, var_to_str({"deadzone": DEADZONE, "events": list})])
	return "\n".join(lines) + "\n"
