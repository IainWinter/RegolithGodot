[gd_resource type="ShaderMaterial" format=3 uid="uid://cvpkag1t2qvmb"]

[sub_resource type="Shader" id="1"]
code = "// the canvas side of the player cloud's own ParticleEffect node: the
// particle pass of the original blended One / One, so every quad added
// color.rgb * (color.a + emissive) onto the scene and its alpha never
// covered anything. the shared particles canvas material blends
// premultiplied, which replaces the scene under a fresh particle instead
// of glowing over it. this one keeps the atlas frame pick of
// CanvasItemMaterial.particles_animation and writes alpha 0 under
// blend_premul_alpha, which is src + dst: plain additive. the vertex
// color carries the (a + emissive) factor from regolith_particles.gdshader
shader_type canvas_item;
render_mode blend_premul_alpha, unshaded;

uniform int h_frames = 4;
uniform int v_frames = 2;

void vertex() {
	float columns = float(h_frames);
	float rows = float(v_frames);
	float total = columns * rows;
	float frame = clamp(floor(INSTANCE_CUSTOM.z * total), 0.0, total - 1.0);
	UV /= vec2(columns, rows);
	UV += vec2(mod(frame, columns) / columns, floor((frame + 0.5) / columns) / rows);
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	COLOR = vec4(tex.rgb * tex.a * COLOR.rgb, 0.0);
}
"

[resource]
shader = SubResource("1")
shader_parameter/h_frames = 4
shader_parameter/v_frames = 2
