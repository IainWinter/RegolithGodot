[configuration]

entry_symbol = "regolith_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/windows/libregolith.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libregolith.windows.template_release.x86_64.dll"
web.debug.wasm32.nothreads = "res://bin/web/libregolith.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32.nothreads = "res://bin/web/libregolith.web.template_release.wasm32.nothreads.wasm"
